# Keep generated Python bytecode out of source distributions even when a
# vendored Python file has been imported locally before the release build.
global-exclude *.pyc *.pyo
prune src/genome_annotation_builder/vendor/genome_spec/reference/__pycache__
include .gitattributes .gitignore
include CHANGELOG.md CONTRIBUTING.md SECURITY.md uv.lock
recursive-include config *.yaml *.json
recursive-include docs *.md
recursive-include schemas *.md
recursive-include scripts *.py
recursive-include tests *.py
include tests/fixtures/synthetic*
include workflow/Snakefile
recursive-include workflow/envs *.yaml
